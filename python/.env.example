# 실제 접속값은 python/.env에 작성합니다.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Firebase Console의 서버 서비스 계정 키. 실제 JSON은 프로젝트 밖에 보관합니다.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=ondolbom-3125e

# 카카오 Developers의 온돌봄 앱 ID(키가 아닌 숫자 ID)
KAKAO_APP_ID=1622719

# 네이버 인가 코드 교환은 각자의 로컬 서버에서 수행한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://10.0.2.2:8000/auth/naver/callback

# 이메일 인증번호 발송. 팀원들은 같은 PASSWORD_RESET_SECRET을 안전하게 공유합니다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
PASSWORD_RESET_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
